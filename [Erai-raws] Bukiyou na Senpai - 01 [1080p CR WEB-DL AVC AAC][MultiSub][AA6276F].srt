Dialogue: 0,0:00:26.19,0:00:27.45,BottomCenter,,0000,0000,0000,,‫- حقًّا؟\N‫- حقًّا.
Dialogue: 0,0:00:27.61,0:00:28.95,BottomCenter,,0000,0000,0000,,‫انظري! تلك هي!
Dialogue: 0,0:00:29.91,0:00:31.78,BottomCenter,,0000,0000,0000,,‫كاناوا من قسم الدعاية!
Dialogue: 0,0:00:31.99,0:00:34.95,BottomCenter,,0000,0000,0000,,‫فاز الملصق الذي اقترحته بجائزة إعلانيّة.
Dialogue: 0,0:00:48.47,0:00:55.35,TopCenter,,0000,0000,0000,,‫بسرعة البرق!\N‫سباك
Dialogue: 0,0:00:58.02,0:01:02.98,TopCenter,,0000,0000,0000,,‫قسم الدعاية - هيتا كوسكي
Dialogue: 0,0:01:04.06,0:01:05.11,BottomCenter,,0000,0000,0000,,‫حسنًا!
Dialogue: 0,0:01:06.53,0:01:07.53,BottomCenter,,0000,0000,0000,,‫صباح الخير.
Dialogue: 0,0:01:17.37,0:01:18.83,BottomCenter,,0000,0000,0000,,‫صباح النور!
Dialogue: 0,0:01:19.96,0:01:21.21,BottomCenter,,0000,0000,0000,,‫صباح الخير.
Dialogue: 0,0:01:21.54,0:01:23.08,BottomCenter,,0000,0000,0000,,‫صباح الخير جميعًا!
Dialogue: 0,0:01:23.29,0:01:25.21,BottomCenter,,0000,0000,0000,,‫صباح الخير.
Dialogue: 0,0:01:25.84,0:01:27.55,BottomCenter,,0000,0000,0000,,‫صباح الخير.
Dialogue: 0,0:01:34.09,0:01:35.26,BottomCenter,,0000,0000,0000,,‫كاناوا-سان...
Dialogue: 0,0:01:35.68,0:01:38.43,BottomCenter,,0000,0000,0000,,‫بخصوص إعلان إس كيو على الإنترنت...
Dialogue: 0,0:01:38.72,0:01:42.85,BottomCenter,,0000,0000,0000,,‫لم يعُد بإمكاننا توظيف\N‫"تسورو-سان"، المؤثّرة التي حجزناها.
Dialogue: 0,0:01:43.02,0:01:44.81,BottomCenter,,0000,0000,0000,,‫ماذا عسانا أن نفعل؟
Dialogue: 0,0:01:45.02,0:01:47.15,BottomCenter,,0000,0000,0000,,‫أنتِ المسؤولة عن هذا الأمر.
Dialogue: 0,0:01:47.36,0:01:51.03,BottomCenter,,0000,0000,0000,,‫قبل أن تأتي إليّ بالأسئلة،\N‫أليس من واجبكِ إعداد مقترح؟
Dialogue: 0,0:01:51.24,0:01:53.07,BottomCenter,,0000,0000,0000,,‫أ-أجل.
Dialogue: 0,0:01:53.28,0:01:55.66,BottomCenter,,0000,0000,0000,,‫إن كنّا بحاجة إلى بديل، فاستخدمي\N‫مواردكِ المتاحة للعثور عليه.
Dialogue: 0,0:01:55.87,0:01:58.79,BottomCenter,,0000,0000,0000,,‫أبلغي الطرف الآخر بأنّنا\N‫سنتواصل معهم بحلول نهاية اليوم.
Dialogue: 0,0:01:59.00,0:02:00.91,BottomCenter,,0000,0000,0000,,‫شـ-شكرًا جزيلًا.
Dialogue: 0,0:02:01.08,0:02:02.46,BottomCenter,,0000,0000,0000,,‫يا إلهي...
Dialogue: 0,0:02:02.67,0:02:05.58,BottomCenter,,0000,0000,0000,,‫صحّحتُ المستندات اللازمة\N‫لإرسالها إلى قسم التخطيط.
Dialogue: 0,0:02:05.75,0:02:08.50,BottomCenter,,0000,0000,0000,,‫ماذا؟! عجبًا، أفعلتِ؟
Dialogue: 0,0:02:09.01,0:02:10.38,BottomCenter,,0000,0000,0000,,‫شكرًا جزيلًا.
Dialogue: 0,0:02:11.01,0:02:14.26,BottomCenter,,0000,0000,0000,,‫كيف تتوقّع إنجاز أيّ\N‫عمل ومكتبك بهذه الحالة؟
Dialogue: 0,0:02:14.64,0:02:16.72,BottomCenter,,0000,0000,0000,,‫- نظّفه.\N‫- حاضر!
Dialogue: 0,0:02:17.85,0:02:19.14,BottomCenter,,0000,0000,0000,,‫كاناوا-سان.
Dialogue: 0,0:02:19.47,0:02:22.18,BottomCenter,,0000,0000,0000,,‫- هل يمكنني التحدّث معك؟\N‫- نعم.
Dialogue: 0,0:02:22.39,0:02:24.90,BottomCenter,,0000,0000,0000,,‫كاناوا-سان رائعة كعادتها اليوم.
Dialogue: 0,0:02:25.48,0:02:26.94,BottomCenter,,0000,0000,0000,,‫أظنّ أنّكِ تقصدين "مُخيفة".
Dialogue: 0,0:02:27.15,0:02:31.65,BottomCenter,,0000,0000,0000,,‫إنّها ليست مخطئة، ولكن\N‫هناك طرق ألطف لقول الأشياء.
Dialogue: 0,0:02:32.24,0:02:33.74,BottomCenter,,0000,0000,0000,,‫كما أخبرتكِ قبل فترة،
Dialogue: 0,0:02:33.91,0:02:37.03,BottomCenter,,0000,0000,0000,,‫سينتقل موظّف جديد\N‫إلى قسمنا ابتداءً من اليوم.
Dialogue: 0,0:02:37.87,0:02:44.75,BottomCenter,,0000,0000,0000,,‫- نعم.\N‫- أوَدُّ أن أُوكِلَكِ بمهمّة تدريبه يا كاناوا-سان.
Dialogue: 0,0:02:45.79,0:02:47.71,BottomCenter,,0000,0000,0000,,‫أنا؟
Dialogue: 0,0:02:47.88,0:02:51.67,BottomCenter,,0000,0000,0000,,‫انظري، أتفهّم أنّكِ مشغولة للغاية.
Dialogue: 0,0:02:51.88,0:02:54.34,BottomCenter,,0000,0000,0000,,‫لكن هذا الشاب الجديد استثنائيّ.
Dialogue: 0,0:02:54.72,0:02:58.93,BottomCenter,,0000,0000,0000,,‫- بيني وبينكِ، كان صاحب أعلى درجة في الامتحان!\N‫- فهمت...
Dialogue: 0,0:02:59.14,0:03:01.72,BottomCenter,,0000,0000,0000,,‫ولهذا السبب نريدك\N‫أنت يا نجمة قسم الدعاية،
Dialogue: 0,0:03:01.93,0:03:04.23,BottomCenter,,0000,0000,0000,,‫أن تقومي بصقله وتهيئته!
Dialogue: 0,0:03:04.64,0:03:05.64,BottomCenter,,0000,0000,0000,,‫مفهوم.
Dialogue: 0,0:03:05.85,0:03:08.36,BottomCenter,,0000,0000,0000,,‫جعلناه يطّلع على مواد\N‫تدريب الموظّفين الجدد،
Dialogue: 0,0:03:08.56,0:03:10.86,BottomCenter,,0000,0000,0000,,‫وتمكّن من استيعاب كلّ شيء جيّدًا.
Dialogue: 0,0:03:11.07,0:03:13.15,BottomCenter,,0000,0000,0000,,‫وكانت ردوده مفعمة بالحياة...
Dialogue: 0,0:03:14.15,0:03:16.41,BottomCenter,,0000,0000,0000,,{\i1}‫لا أُريد هذا حقًّا!{\i0}
Dialogue: 0,0:03:16.61,0:03:18.66,BottomCenter,,0000,0000,0000,,{\i1}‫لِمَ أنا من بين كلّ الناس؟{\i0}
Dialogue: 0,0:03:18.82,0:03:20.24,BottomCenter,,0000,0000,0000,,{\i1}‫مهاراتي في التواصل ليست جيّدة.{\i0}
Dialogue: 0,0:03:20.45,0:03:23.62,BottomCenter,,0000,0000,0000,,{\i1}‫من المؤكّد أنّ المدير يُدرك{\i0}\N{\i1}‫أنّني لا أنسجم مع أجواء المكتب...{\i0}
Dialogue: 0,0:03:24.00,0:03:25.46,BottomCenter,,0000,0000,0000,,{\i1}‫أظنّ أنّه لا يُدرك.{\i0}
Dialogue: 0,0:03:25.62,0:03:28.08,BottomCenter,,0000,0000,0000,,{\i1}‫في مختلف الأحوال،{\i0}\N{\i1}‫يمكن أن يكون غبيًّا جدًّا.{\i0}
Dialogue: 0,0:03:28.96,0:03:31.50,BottomCenter,,0000,0000,0000,,{\i1}‫رسّختُ صورتي أخيرًا بصفتي{\i0}\N{\i1}‫"تلك التي ترفض الخروج للشرب،{\i0}
Dialogue: 0,0:03:31.71,0:03:33.42,BottomCenter,,0000,0000,0000,,{\i1}‫لذا لا تُكلّفوا أنفسكم عناء دعوتها".{\i0}
Dialogue: 0,0:03:33.63,0:03:34.84,BottomCenter,,0000,0000,0000,,‫كاناوا-سان؟
Dialogue: 0,0:03:35.05,0:03:36.63,BottomCenter,,0000,0000,0000,,‫انسَ الأمر. إنّها لا تنضمّ إلينا أبدًا.
Dialogue: 0,0:03:37.01,0:03:39.68,BottomCenter,,0000,0000,0000,,{\i1}‫كانت الأمور قد بدأت تصبح أسهل أخيرًا.{\i0}
Dialogue: 0,0:03:41.60,0:03:46.19,BottomCenter,,0000,0000,0000,,{\i1}‫تعليم المبتدئ كيفيّة أداء عمله ليس{\i0}\N{\i1}‫الشيء الوحيد الذي سيتعيّن عليّ فعله.{\i0}
Dialogue: 0,0:03:46.39,0:03:48.15,BottomCenter,,0000,0000,0000,,‫صباح الخير!
Dialogue: 0,0:03:50.56,0:03:51.90,BottomCenter,,0000,0000,0000,,‫كاميغاوا-كن.
Dialogue: 0,0:03:52.07,0:03:53.82,BottomCenter,,0000,0000,0000,,‫آسف لوصولي متأخّرًا!
Dialogue: 0,0:03:53.99,0:03:56.65,BottomCenter,,0000,0000,0000,,‫كنتُ أُنظّف مكتبي المؤقّت.
Dialogue: 0,0:03:57.32,0:03:59.62,BottomCenter,,0000,0000,0000,,‫عذرًا. هل قاطعتكما؟
Dialogue: 0,0:03:59.78,0:04:03.95,BottomCenter,,0000,0000,0000,,‫كاميغاوا-كن، هذه هي موجِّهتك، كاناوا-سان.
Dialogue: 0,0:04:04.41,0:04:06.91,BottomCenter,,0000,0000,0000,,‫سُررتُ بلقائكِ! أنا كاميغاوا يو!
Dialogue: 0,0:04:07.12,0:04:10.00,BottomCenter,,0000,0000,0000,,‫- أجل...\N‫- آسف!
Dialogue: 0,0:04:10.46,0:04:13.25,BottomCenter,,0000,0000,0000,,‫ينبغي أن أستخدم اسم عائلتي\N‫فقط في هذه الحالات، أليس كذلك؟
Dialogue: 0,0:04:13.63,0:04:16.47,BottomCenter,,0000,0000,0000,,‫أنا كاناوا أزوسا. سُررتُ بلقائك.
Dialogue: 0,0:04:16.76,0:04:20.26,BottomCenter,,0000,0000,0000,,‫أجل! سأكون تحت رعايتك يا كاناوا-سينباي!
Dialogue: 0,0:04:20.76,0:04:22.93,BottomCenter,,0000,0000,0000,,‫أتوقّع منك أشياء عظيمة يا كاميغاوا-كن!
Dialogue: 0,0:04:23.26,0:04:24.64,BottomCenter,,0000,0000,0000,,{\i1}‫يا له من شاب طيّب.{\i0}
Dialogue: 0,0:04:24.85,0:04:28.69,BottomCenter,,0000,0000,0000,,{\i1}‫- يملك هذا السحر الودود.{\i0}\N{\i1}‫- حسنًا، سأترك الباقي لكِ يا كاناوا-سان.{\i0}
Dialogue: 0,0:04:28.94,0:04:29.94,BottomCenter,,0000,0000,0000,,‫نعم.
Dialogue: 0,0:04:31.19,0:04:35.11,BottomCenter,,0000,0000,0000,,{\i1}‫إذًا سأكون مسؤولة عن رعاية{\i0}\N{\i1}‫هذا الشاب، الجديد في هذا المجال.{\i0}
Dialogue: 0,0:04:35.32,0:04:38.07,BottomCenter,,0000,0000,0000,,{\i1}‫إنّها مهمّة ثقيلة، ولكن عليّ أن أبذل جهدي.{\i0}
Dialogue: 0,0:04:42.45,0:04:46.12,TopCenter,,0000,0000,0000,,‫زميلتي الأكبر الغريبة
Dialogue: 0,0:05:18.78,0:05:19.99,TopCenter,,0000,0000,0000,,‫- آسف لإزعاجك في هذا الوقت المتأخر.\N‫لا عليك! كيف يمكنني مساعدتك؟ -\N‫- لا بأس! أحب مثل هذه الأشياء!\N‫- أي كلب تحب؟\N‫- لنرَ، الاختيار صعب.\N‫- أظنها تشبه بعض.\N‫- سأجد صور مختلفة.
Dialogue: 0,0:06:12.79,0:06:14.92,BottomCenter,,0000,0000,0000,,‫"أنا؟ الموجِّهة؟!"
Dialogue: 0,0:06:19.30,0:06:23.59,BottomCenter,,0000,0000,0000,,‫أنا متأكّدة من أنّك سمعت الكثير عن\N‫شركتنا خلال تدريب الموظّفين الجدد.
Dialogue: 0,0:06:24.22,0:06:27.35,BottomCenter,,0000,0000,0000,,‫مع أنّنا بدأنا بتطوير ألعاب الفيديو،
Dialogue: 0,0:06:27.51,0:06:32.31,BottomCenter,,0000,0000,0000,,‫إلّا أنّنا توسّعنا في الوقت الحاضر\N‫إلى الكتب والملابس والعقارات وغيرها.
Dialogue: 0,0:06:33.10,0:06:36.73,BottomCenter,,0000,0000,0000,,‫هذا يعني أنّ هناك المزيد من المشاريع\N‫التي يتعيّن على قسم الدعاية التعامل معها.
Dialogue: 0,0:06:37.15,0:06:39.32,BottomCenter,,0000,0000,0000,,‫إن كان أيّ شيء غير\N‫واضح، فتحدّث معي على الفور.
Dialogue: 0,0:06:39.52,0:06:40.53,BottomCenter,,0000,0000,0000,,‫حاضر!
Dialogue: 0,0:06:41.24,0:06:42.65,BottomCenter,,0000,0000,0000,,‫مكتبي هنا.
Dialogue: 0,0:06:42.86,0:06:44.82,BottomCenter,,0000,0000,0000,,‫- ومكتبك بجانبي.\N‫- نعم!
Dialogue: 0,0:06:45.03,0:06:49.33,BottomCenter,,0000,0000,0000,,‫- هذا هو المطبخ. أحضر كوبك الخاص.\N‫- نعم!
Dialogue: 0,0:06:49.53,0:06:51.50,BottomCenter,,0000,0000,0000,,‫- آلة التصوير.\N‫- نعم!
Dialogue: 0,0:06:51.70,0:06:52.87,BottomCenter,,0000,0000,0000,,‫خلفي يوجد ورق الطباعة.
Dialogue: 0,0:06:53.04,0:06:54.04,BottomCenter,,0000,0000,0000,,‫أ-أجل!
Dialogue: 0,0:06:55.29,0:06:58.04,BottomCenter,,0000,0000,0000,,‫- أقرب حمّام!\N‫- نـ-نعم!
Dialogue: 0,0:06:58.21,0:06:59.46,TopCenter,,0000,0000,0000,,‫فطيرة البطاطا الحلوة
Dialogue: 0,0:07:00.13,0:07:02.84,BottomCenter,,0000,0000,0000,,‫الوجبات الخفيفة من\N‫رحلات العمل تُخبّأ هنا.
Dialogue: 0,0:07:03.05,0:07:04.84,BottomCenter,,0000,0000,0000,,‫لك حريّة أخذ ما تُريد.
Dialogue: 0,0:07:05.05,0:07:06.68,BottomCenter,,0000,0000,0000,,‫شـ-شكرًا لك.
Dialogue: 0,0:07:06.89,0:07:09.31,BottomCenter,,0000,0000,0000,,‫أظنّ أنّ هذا يغطّي كلّ شيء.
Dialogue: 0,0:07:09.51,0:07:12.14,BottomCenter,,0000,0000,0000,,‫الأماكن الأخرى التي\N‫ينبغي أن أُريه إيّاها هي...
Dialogue: 0,0:07:13.93,0:07:17.02,BottomCenter,,0000,0000,0000,,‫شكرًا جزيلًا لكِ على هذه الجولة.
Dialogue: 0,0:07:17.23,0:07:20.19,BottomCenter,,0000,0000,0000,,‫هل يمكنني أن أسألكِ إن\N‫احتجتُ مساعدة في أيّ شيء؟
Dialogue: 0,0:07:20.40,0:07:22.19,BottomCenter,,0000,0000,0000,,‫نعم. افعل ذلك رجاءً.
Dialogue: 0,0:07:23.90,0:07:26.95,BottomCenter,,0000,0000,0000,,{\i1}‫حسنًا. أظنّ أنّني تمكّنتُ{\i0}\N{\i1}‫من تعليمه الأشياء المهمّة.{\i0}
Dialogue: 0,0:07:30.24,0:07:31.79,BottomCenter,,0000,0000,0000,,‫معذرةً يا سينباي...
Dialogue: 0,0:07:31.99,0:07:33.00,BottomCenter,,0000,0000,0000,,‫ما الأمر؟
Dialogue: 0,0:07:33.29,0:07:35.33,BottomCenter,,0000,0000,0000,,‫عذرًا، ولكن...
Dialogue: 0,0:07:35.54,0:07:38.46,BottomCenter,,0000,0000,0000,,‫كنتُ أتساءل ما الذي\N‫يُفترض بي أن أفعله اليوم.
Dialogue: 0,0:07:41.34,0:07:43.88,BottomCenter,,0000,0000,0000,,{\i1}‫كان عليّ أن أُعلّمه كيفيّة أداء عمله!{\i0}
Dialogue: 0,0:07:45.63,0:07:48.22,BottomCenter,,0000,0000,0000,,‫أنا على وشك الذهاب إلى\N‫اجتماع مع أحد العملاء.
Dialogue: 0,0:07:48.43,0:07:50.55,BottomCenter,,0000,0000,0000,,‫سأجعلك تنضمّ إليّ.
Dialogue: 0,0:07:50.72,0:07:52.31,BottomCenter,,0000,0000,0000,,‫مـ-مفهوم!
Dialogue: 0,0:07:52.72,0:07:55.39,BottomCenter,,0000,0000,0000,,‫كلّ ما عليك فعله هو\N‫مرافقتي ومراقبة الاجتماع.
Dialogue: 0,0:07:55.60,0:07:56.98,BottomCenter,,0000,0000,0000,,‫ولكن قبل ذلك...
Dialogue: 0,0:07:59.94,0:08:02.61,BottomCenter,,0000,0000,0000,,‫- لنتدرّب على تبادل بطاقات العمل.\N‫- حاضر.
Dialogue: 0,0:08:02.82,0:08:06.03,BottomCenter,,0000,0000,0000,,‫لا تحتاج إلى التركيز\N‫بشدّة على آداب العمل،
Dialogue: 0,0:08:06.24,0:08:09.32,BottomCenter,,0000,0000,0000,,‫ولكن ينبغي أن تجعلها\N‫عادة لتعتاد على الأساسيّات—
Dialogue: 0,0:08:18.92,0:08:20.71,BottomCenter,,0000,0000,0000,,‫تفضّلي يا سينباي.
Dialogue: 0,0:08:35.56,0:08:38.69,BottomCenter,,0000,0000,0000,,‫أرجو أن تسمحوا لموظّفنا الجديد\N‫بالانضمام إلى الاجتماع اليوم.
Dialogue: 0,0:08:39.69,0:08:42.77,BottomCenter,,0000,0000,0000,,‫أنا كاميغاوا. سُررتُ بلقائكم جميعًا.
Dialogue: 0,0:08:43.19,0:08:45.61,BottomCenter,,0000,0000,0000,,‫سُررنا بلقائك يا كاميغاوا-سان.
Dialogue: 0,0:08:45.98,0:08:47.86,BottomCenter,,0000,0000,0000,,{\i1}‫تحيّة منعشة...{\i0}
Dialogue: 0,0:08:48.20,0:08:50.36,BottomCenter,,0000,0000,0000,,{\i1}‫تبادل سلس لبطاقات العمل...{\i0}
Dialogue: 0,0:08:50.70,0:08:53.91,BottomCenter,,0000,0000,0000,,{\i1}‫بينما أنا، الموجِّهة، تبادلتُ{\i0}\N{\i1}‫بطاقاتي مع الأرضيّة...{\i0}
Dialogue: 0,0:08:54.12,0:08:56.08,BottomCenter,,0000,0000,0000,,‫بناءً على البحث المعروض،
Dialogue: 0,0:08:59.16,0:09:03.59,BottomCenter,,0000,0000,0000,,{\i1}‫عليّ أن أحافظ على الأقلّ{\i0}\N{\i1}‫على كرامتي كموجِّهة أثناء عملي.{\i0}
Dialogue: 0,0:09:04.63,0:09:07.17,BottomCenter,,0000,0000,0000,,{\i1}‫أُقدّر أنّه ينظر إليّ بكلّ هذا الإخلاص،{\i0}
Dialogue: 0,0:09:07.34,0:09:10.09,BottomCenter,,0000,0000,0000,,{\i1}‫لكنّني أصبحتُ متوتّرة من كثرة تحديقه...{\i0}
Dialogue: 0,0:09:13.35,0:09:17.93,BottomCenter,,0000,0000,0000,,{\i1}‫لا. كلّ حركة أقوم بها كموجِّهة{\i0}\N{\i1}‫تؤثّر على تطوّر الموظّف الجديد!{\i0}
Dialogue: 0,0:09:18.18,0:09:20.23,BottomCenter,,0000,0000,0000,,{\i1}‫هذا ليس وقت التوتّر!{\i0}
Dialogue: 0,0:09:21.31,0:09:24.94,BottomCenter,,0000,0000,0000,,{\i1}‫لا فائدة! {\i0}{\i1}‫أنا متوتّرة جدًّا!{\i0}
Dialogue: 0,0:09:30.78,0:09:33.07,BottomCenter,,0000,0000,0000,,‫أحسنتِ عملًا في الداخل يا كاناوا-سينباي.
Dialogue: 0,0:09:33.49,0:09:34.53,BottomCenter,,0000,0000,0000,,‫أجل...
Dialogue: 0,0:09:34.74,0:09:35.78,BottomCenter,,0000,0000,0000,,{\i1}‫أنا متعبة.{\i0}
Dialogue: 0,0:09:35.99,0:09:40.25,BottomCenter,,0000,0000,0000,,{\i1}‫ليس من العمل، بل من{\i0}\N{\i1}‫العبء الثقيل لكوني موجِّهة.{\i0}
Dialogue: 0,0:09:40.83,0:09:42.71,BottomCenter,,0000,0000,0000,,{\i1}‫حان وقت الغداء تقريبًا.{\i0}
Dialogue: 0,0:09:42.92,0:09:46.25,BottomCenter,,0000,0000,0000,,{\i1}‫بصفتي موجِّهته، أنا التي ينبغي{\i0}\N{\i1}‫أن تُقدّم الدعوة، أليس كذلك؟{\i0}
Dialogue: 0,0:09:48.26,0:09:51.09,BottomCenter,,0000,0000,0000,,{\i1}‫المطعم العائلي الذي كنتُ أرتاده{\i0}\N{\i1}‫كثيرًا مع سينباي قد يكون مناسبًا.{\i0}
Dialogue: 0,0:09:55.51,0:09:59.81,BottomCenter,,0000,0000,0000,,{\i1}‫ألا يُعتبر تحرّشًا في مكان العمل أن يطلب{\i0}\N{\i1}‫موظّف أقدم من المبتدئ الخروج لتناول الغداء؟{\i0}
Dialogue: 0,0:10:00.10,0:10:01.48,BottomCenter,,0000,0000,0000,,{\i1}‫ولكن إن لم أدعُه،{\i0}
Dialogue: 0,0:10:01.69,0:10:05.48,BottomCenter,,0000,0000,0000,,{\i1}‫فسيبدو الأمر وكأنّني أُرسل رسالة مفادها{\i0}\N{\i1}‫"لا أعتزم أن أكون ودودة معك"، أليس كذلك؟{\i0}
Dialogue: 0,0:10:06.44,0:10:08.78,BottomCenter,,0000,0000,0000,,{\i1}‫وعمّا سنتحدّث حتّى؟{\i0}
Dialogue: 0,0:10:09.07,0:10:11.32,BottomCenter,,0000,0000,0000,,{\i1}‫عن الطقس؟ {\i0}{\i1}‫عن الأسهم؟{\i0}
Dialogue: 0,0:10:11.53,0:10:16.45,BottomCenter,,0000,0000,0000,,{\i1}‫المحادثات اليوميّة هي{\i0}\N{\i1}‫أصعب موضوع بالنسبة لي!{\i0}
Dialogue: 0,0:10:16.66,0:10:17.83,BottomCenter,,0000,0000,0000,,‫سينباي؟
Dialogue: 0,0:10:18.62,0:10:21.54,BottomCenter,,0000,0000,0000,,‫أنا... أنا ذاهبة إلى اجتماع الآن!
Dialogue: 0,0:10:22.87,0:10:25.38,BottomCenter,,0000,0000,0000,,‫لذا تناول غداءك بينما أفعل ذلك.
Dialogue: 0,0:10:26.42,0:10:28.38,BottomCenter,,0000,0000,0000,,‫مـ-مفهوم.
Dialogue: 0,0:10:40.31,0:10:43.35,BottomCenter,,0000,0000,0000,,{\i1}‫بِمَ كنتُ أُفكّر، أهرب؟{\i0}
Dialogue: 0,0:10:55.20,0:10:56.87,BottomCenter,,0000,0000,0000,,‫سأغادر الآن.
Dialogue: 0,0:10:57.91,0:10:58.91,BottomCenter,,0000,0000,0000,,‫حسنًا.
Dialogue: 0,0:11:01.87,0:11:04.16,BottomCenter,,0000,0000,0000,,{\i1}‫"حسنًا"؟ فقط "حسنًا"؟{\i0}
Dialogue: 0,0:11:04.66,0:11:07.08,BottomCenter,,0000,0000,0000,,{\i1}‫كان بإمكاني أن أشكره على الأقلّ.{\i0}
Dialogue: 0,0:11:07.50,0:11:09.29,BottomCenter,,0000,0000,0000,,‫شكرًا لكِ على اليوم.
Dialogue: 0,0:11:09.59,0:11:12.55,BottomCenter,,0000,0000,0000,,‫لستُ متأكّدًا إن كنتُ قد أبليتُ حسنًا لأنّني\N‫كنتُ متوتّرًا جدًّا، كونه يومي الأوّل وما إلى ذلك...
Dialogue: 0,0:11:18.26,0:11:21.60,BottomCenter,,0000,0000,0000,,‫لا يوجد مبتدئ مثاليّ\N‫في يومه الأوّل في العمل.
Dialogue: 0,0:11:22.27,0:11:23.93,BottomCenter,,0000,0000,0000,,‫أظنّ ذلك.
Dialogue: 0,0:11:24.39,0:11:26.23,BottomCenter,,0000,0000,0000,,‫يمكنك الاعتماد عليّ من الآن فصاعدًا.
Dialogue: 0,0:11:26.44,0:11:28.36,BottomCenter,,0000,0000,0000,,‫هذا هو دور الموجِّهين.
Dialogue: 0,0:11:28.56,0:11:29.57,BottomCenter,,0000,0000,0000,,‫نعم!
Dialogue: 0,0:11:29.77,0:11:32.82,BottomCenter,,0000,0000,0000,,‫أتطلّع إلى العمل معكِ\N‫غدًا أيضًا يا كاناوا-سينباي!
Dialogue: 0,0:11:35.20,0:11:36.20,BottomCenter,,0000,0000,0000,,‫حسنًا.
Dialogue: 0,0:11:41.49,0:11:42.91,BottomCenter,,0000,0000,0000,,‫أحسنت عملًا!
Dialogue: 0,0:11:43.12,0:11:44.16,BottomCenter,,0000,0000,0000,,‫أحسنتم عملًا اليوم!
Dialogue: 0,0:11:44.37,0:11:45.54,BottomCenter,,0000,0000,0000,,‫كيف سار الأمر؟
Dialogue: 0,0:11:45.75,0:11:48.71,BottomCenter,,0000,0000,0000,,‫كنتُ متوتّرًا، ولكن بفضل\N‫الجميع، أظنّ أنّني تدبّرتُ أمري.
Dialogue: 0,0:11:53.63,0:11:55.63,BottomCenter,,0000,0000,0000,,‫كان متوتّرًا؟
Dialogue: 0,0:11:55.84,0:11:56.97,BottomCenter,,0000,0000,0000,,‫بالطبع كان كذلك.
Dialogue: 0,0:11:57.18,0:11:59.14,BottomCenter,,0000,0000,0000,,‫حتّى لو كان صاحب أعلى\N‫درجة، فهو لا يزال مبتدئًا.
Dialogue: 0,0:12:00.72,0:12:02.60,BottomCenter,,0000,0000,0000,,‫ لستُ جيّدة.
Dialogue: 0,0:12:02.81,0:12:04.89,BottomCenter,,0000,0000,0000,,‫كلّ ما فعلته هو القلق بشأن نفسي.
Dialogue: 0,0:12:06.69,0:12:09.27,BottomCenter,,0000,0000,0000,,‫عليّ أن أكون سينباي يُعتمد عليها.
Dialogue: 0,0:12:10.86,0:12:14.11,BottomCenter,,0000,0000,0000,,‫كبداية، عليّ أن أكون أكثر صراحة معه.
Dialogue: 0,0:12:20.24,0:12:24.08,BottomCenter,,0000,0000,0000,,‫ كاميغاوا-كن. من أيّ محافظة أنت؟
Dialogue: 0,0:12:24.29,0:12:25.70,BottomCenter,,0000,0000,0000,,‫أنا من سايتاما.
Dialogue: 0,0:12:25.91,0:12:28.50,BottomCenter,,0000,0000,0000,,‫ماذا؟ أنا أيضًا! من أين في سايتاما؟
Dialogue: 0,0:12:28.71,0:12:30.58,BottomCenter,,0000,0000,0000,,‫- من كاواغوتشي—\N‫- مهلًا!
Dialogue: 0,0:12:35.71,0:12:37.68,BottomCenter,,0000,0000,0000,,‫أنت تعترض الطريق. تنحّ.
Dialogue: 0,0:12:38.01,0:12:39.30,BottomCenter,,0000,0000,0000,,‫آسف!
Dialogue: 0,0:12:50.23,0:12:53.48,BottomCenter,,0000,0000,0000,,{\i1}‫فعلتها! قمت بالتحيّة بشكل صحيح!{\i0}
Dialogue: 0,0:12:57.49,0:13:02.74,BottomCenter,,0000,0000,0000,,‫- اليوم، سأجعلك تكتب مقترحًا لتطبيق مانغا لشركة صغيرة.\N‫- حاضر.
Dialogue: 0,0:13:02.95,0:13:06.20,BottomCenter,,0000,0000,0000,,‫أعددتُ لك عيّنات من\N‫مقترحات أعمالي السابقة.
Dialogue: 0,0:13:06.66,0:13:08.25,BottomCenter,,0000,0000,0000,,‫يمكنك استخدامها كمرجع.
Dialogue: 0,0:13:08.41,0:13:10.58,BottomCenter,,0000,0000,0000,,‫حاضر. شكرًا جزيلًا.
Dialogue: 0,0:13:12.42,0:13:14.29,BottomCenter,,0000,0000,0000,,{\i1}‫فقط انتظر.{\i0}
Dialogue: 0,0:13:14.88,0:13:18.34,BottomCenter,,0000,0000,0000,,{\i1}‫اليوم سيكون اليوم الذي{\i0}\N{\i1}‫سأدعوك فيه لتناول الغداء!{\i0}
Dialogue: 0,0:13:22.80,0:13:26.22,BottomCenter,,0000,0000,0000,,‫- عذرًا، كاناوا-سينباي؟\N‫- ماذا؟
Dialogue: 0,0:13:26.39,0:13:30.14,BottomCenter,,0000,0000,0000,,‫أرسلتُ لك مقترحي في محادثة\N‫العمل. هلّا تلقين نظرة عليه؟
Dialogue: 0,0:13:33.23,0:13:37.15,BottomCenter,,0000,0000,0000,,‫إنّه مليء بالكلام. اجعل\N‫مفاهيمك موجزة وسهلة الفهم.
Dialogue: 0,0:13:37.36,0:13:39.61,BottomCenter,,0000,0000,0000,,‫حاضر. سأُصلحه على الفور.
Dialogue: 0,0:13:39.94,0:13:41.86,BottomCenter,,0000,0000,0000,,‫يمكنك فعل ذلك بعد الغداء.
Dialogue: 0,0:13:42.32,0:13:43.32,BottomCenter,,0000,0000,0000,,‫حاضر.
Dialogue: 0,0:13:50.04,0:13:53.46,BottomCenter,,0000,0000,0000,,{\i1}‫هذه هي! هذا يبدو طبيعيًّا جدًّا!{\i0}
Dialogue: 0,0:13:53.67,0:13:55.84,BottomCenter,,0000,0000,0000,,{\i1}‫حسنًا، الآن فرصتي!{\i0}
Dialogue: 0,0:13:58.76,0:13:59.76,BottomCenter,,0000,0000,0000,,‫ماذا؟
Dialogue: 0,0:14:02.43,0:14:04.22,BottomCenter,,0000,0000,0000,,‫يا ويحي.
Dialogue: 0,0:14:07.06,0:14:08.47,BottomCenter,,0000,0000,0000,,‫ساخن، ساخن، ساخن...
Dialogue: 0,0:14:10.39,0:14:11.60,BottomCenter,,0000,0000,0000,,‫كاناوا-سينباي؟
Dialogue: 0,0:14:13.06,0:14:15.06,BottomCenter,,0000,0000,0000,,‫هل تظنّ أنّ هذا كافٍ؟
Dialogue: 0,0:14:15.27,0:14:17.52,BottomCenter,,0000,0000,0000,,‫الاهتمام بصحّتك هو أيضًا جزء من العمل!
Dialogue: 0,0:14:17.73,0:14:19.94,BottomCenter,,0000,0000,0000,,‫أنتِ على حقّ. آسف!
Dialogue: 0,0:14:20.15,0:14:21.78,BottomCenter,,0000,0000,0000,,‫ميزانيّتي محدودة، لذا...
Dialogue: 0,0:14:21.99,0:14:24.16,BottomCenter,,0000,0000,0000,,‫أ-أهكذا الأمر؟
Dialogue: 0,0:14:24.99,0:14:27.83,BottomCenter,,0000,0000,0000,,{\i1}‫فوّتُ التوقيت تمامًا.{\i0}
Dialogue: 0,0:14:27.99,0:14:31.50,BottomCenter,,0000,0000,0000,,{\i1}‫وفوق ذلك، إنّه مفلس... وصل به{\i0}\N{\i1}‫الحال إلى أكل كوب واحد من الرامن...{\i0}
Dialogue: 0,0:14:31.71,0:14:34.04,BottomCenter,,0000,0000,0000,,{\i1}‫جعلني أقلق عليه!{\i0}
Dialogue: 0,0:14:43.93,0:14:49.18,BottomCenter,,0000,0000,0000,,‫كيف يمكن لموظّف أقدم أن يرعى مبتدئيه\N‫إن لم يتمكّن حتّى من دعوتهم لتناول الغداء؟
Dialogue: 0,0:14:52.48,0:14:53.77,BottomCenter,,0000,0000,0000,,‫كانا.
Dialogue: 0,0:14:53.98,0:14:55.52,BottomCenter,,0000,0000,0000,,‫لِمَ تتنهّدين؟
Dialogue: 0,0:14:57.36,0:14:58.82,BottomCenter,,0000,0000,0000,,‫سيكون كلّ شيء على ما يرام.
Dialogue: 0,0:14:59.02,0:15:00.40,BottomCenter,,0000,0000,0000,,‫أنتِ تبذلين جهدكِ.
Dialogue: 0,0:15:01.40,0:15:04.45,BottomCenter,,0000,0000,0000,,‫كونكِ صريحة هي نقطة قوّتك.
Dialogue: 0,0:15:04.66,0:15:07.45,BottomCenter,,0000,0000,0000,,‫أنا متأكّدة من أنّ الجميع\N‫سيرون ذلك يومًا ما.
Dialogue: 0,0:15:07.95,0:15:09.58,BottomCenter,,0000,0000,0000,,‫ أضمن ذلك.
Dialogue: 0,0:15:11.08,0:15:13.00,BottomCenter,,0000,0000,0000,,‫كانزاكي-سينباي...
Dialogue: 0,0:15:16.33,0:15:18.29,TopCenter,,0000,0000,0000,,‫كانكايجي
Dialogue: 0,0:15:32.06,0:15:35.14,BottomCenter,,0000,0000,0000,,‫مفهوم. سأشرح ذلك للطرف الآخر.
Dialogue: 0,0:15:35.35,0:15:36.90,BottomCenter,,0000,0000,0000,,{\i1}‫أنقذتِ حياتي!{\i0}
Dialogue: 0,0:15:37.06,0:15:39.86,BottomCenter,,0000,0000,0000,,{\i1}‫هذا يُظهر أنّ ما يحتاجه{\i0}\N{\i1}‫المرء حقًّا هو زميل يُعتمد عليه!{\i0}
Dialogue: 0,0:15:40.19,0:15:41.61,BottomCenter,,0000,0000,0000,,‫هل كان هذا كلّ ما لديك لتقوله؟
Dialogue: 0,0:15:42.90,0:15:45.70,BottomCenter,,0000,0000,0000,,{\i1}‫ينبغي أن تُجرّبي الأحاديث{\i0}\N{\i1}‫الصغيرة في بعض الأحيان.{\i0}
Dialogue: 0,0:15:46.11,0:15:47.16,BottomCenter,,0000,0000,0000,,{\i1}‫صحيح!{\i0}
Dialogue: 0,0:15:47.36,0:15:51.12,BottomCenter,,0000,0000,0000,,{\i1}‫ذلك المقهى التعاوني الذي عملنا{\i0}\N{\i1}‫عليه؟ سيكون هناك جزء ثانٍ.{\i0}
Dialogue: 0,0:15:51.33,0:15:53.66,BottomCenter,,0000,0000,0000,,{\i1}‫أظنّ أنّكِ ستتلقّين أخبارًا{\i0}\N{\i1}‫عن العمل هناك قريبًا.{\i0}
Dialogue: 0,0:15:53.87,0:15:54.95,BottomCenter,,0000,0000,0000,,‫فهمت.
Dialogue: 0,0:15:55.54,0:15:57.37,BottomCenter,,0000,0000,0000,,{\i1}‫هل يشغل بالكِ شيء؟{\i0}
Dialogue: 0,0:15:57.54,0:16:02.09,BottomCenter,,0000,0000,0000,,‫فقط أنّ هذه قد تكون فرصة\N‫جيّدة لتجربة الموظّف الجديد.
Dialogue: 0,0:16:02.25,0:16:03.30,BottomCenter,,0000,0000,0000,,‫أجل!
Dialogue: 0,0:16:03.51,0:16:05.92,BottomCenter,,0000,0000,0000,,‫أنتِ موجِّهته، أليس كذلك؟
Dialogue: 0,0:16:06.13,0:16:09.14,BottomCenter,,0000,0000,0000,,‫من كان يظنّ أنّ شخصًا مثل\N‫كاناوا، التي درّبتها كانزاكي-سينباي،
Dialogue: 0,0:16:09.34,0:16:11.56,BottomCenter,,0000,0000,0000,,‫ستكون التالية في تدريب الآخرين.
Dialogue: 0,0:16:12.31,0:16:14.85,BottomCenter,,0000,0000,0000,,‫ماذا تقصد بـ"شخصًا مثل"؟
Dialogue: 0,0:16:15.14,0:16:17.73,BottomCenter,,0000,0000,0000,,{\i1}‫لا تكوني قاسية جدًّا على المبتدئ.{\i0}
Dialogue: 0,0:16:17.94,0:16:20.10,BottomCenter,,0000,0000,0000,,{\i1}‫واحرصي على التواصل معه.{\i0}
Dialogue: 0,0:16:20.31,0:16:21.61,BottomCenter,,0000,0000,0000,,‫لا توجد مشكلة.
Dialogue: 0,0:16:21.94,0:16:25.61,BottomCenter,,0000,0000,0000,,{\i1}‫تمكّنتُ من تحيّته اليوم،{\i0}\N{\i1}‫وحاولتُ دعوته لتناول الغداء!{\i0}
Dialogue: 0,0:16:25.94,0:16:31.12,BottomCenter,,0000,0000,0000,,{\i1}‫لمعلوماتكِ، "حسنًا" و"أجل" لا تُعَدّان{\i0}\N{\i1}‫محادثات لائقة. تعلمين ذلك، أليس كذلك؟{\i0}
Dialogue: 0,0:16:31.78,0:16:35.08,BottomCenter,,0000,0000,0000,,‫- بالطبع أعلم!\N‫- أنا قلق.
Dialogue: 0,0:16:35.29,0:16:38.96,BottomCenter,,0000,0000,0000,,‫ تعلمين مدى كثرة تغيير الناس\N‫لوظائفهم في هذه الأيّام، أليس كذلك؟
Dialogue: 0,0:16:39.33,0:16:40.46,BottomCenter,,0000,0000,0000,,{\i1}‫تغيير الوظائف؟!{\i0}
Dialogue: 0,0:16:40.67,0:16:43.84,BottomCenter,,0000,0000,0000,,{\i1}‫إنّه على حقّ. هذا ممكن.{\i0}
Dialogue: 0,0:16:44.00,0:16:46.51,BottomCenter,,0000,0000,0000,,{\i1}‫ ما رأيكِ في محاولة{\i0}\N{\i1}‫قراءة كتب تطوير الذات؟{\i0}
Dialogue: 0,0:16:46.72,0:16:47.80,BottomCenter,,0000,0000,0000,,{\i1}‫أي، أشياء مثل،{\i0}
Dialogue: 0,0:16:48.63,0:16:52.30,BottomCenter,,0000,0000,0000,,{\i1}‫"المدير الكفء لا يوبّخ مرؤوسيه!"{\i0}
Dialogue: 0,0:16:53.89,0:16:55.10,BottomCenter,,0000,0000,0000,,‫لا داعي.
Dialogue: 0,0:16:55.56,0:16:59.73,BottomCenter,,0000,0000,0000,,‫قصص نجاح الآخرين لن\N‫تكون مفيدة لي بالضرورة.
Dialogue: 0,0:17:10.99,0:17:12.49,BottomCenter,,0000,0000,0000,,‫أحسنتِ عملًا اليوم.
Dialogue: 0,0:17:12.70,0:17:14.24,BottomCenter,,0000,0000,0000,,‫أحسنتِ عملًا اليوم.
Dialogue: 0,0:17:33.01,0:17:34.64,TopCenter,,0000,0000,0000,,‫- لا شيء أكثر صدقًا من "الحظ"\N‫- التأثير الضار لرغبتك بأن تكون محبوبًا\N‫- لماذا نريد أن نكون "محبوبين"؟
Dialogue: 0,0:17:48.74,0:17:51.66,BottomCenter,,0000,0000,0000,,‫ نسيتُ شراء العشاء!
Dialogue: 0,0:18:02.25,0:18:05.63,BottomCenter,,0000,0000,0000,,‫وبعد أن أخبرته أنّ الاهتمام\N‫بصحّتك جزء من العمل...
Dialogue: 0,0:18:06.71,0:18:08.42,BottomCenter,,0000,0000,0000,,‫الخضروات، تمّ.
Dialogue: 0,0:18:11.93,0:18:13.93,TopCenter,,0000,0000,0000,,‫رئيس متمكن
Dialogue: 0,0:18:15.64,0:18:19.31,BottomCenter,,0000,0000,0000,,‫"مهارات التواصل لتكون أفضل مدير".
Dialogue: 0,0:18:19.52,0:18:21.94,BottomCenter,,0000,0000,0000,,‫"التحيّة أساس التواصل".
Dialogue: 0,0:18:22.14,0:18:24.48,BottomCenter,,0000,0000,0000,,‫"ابتسمي بإشراق".
Dialogue: 0,0:18:25.44,0:18:27.02,BottomCenter,,0000,0000,0000,,‫أنت تعترض الطريق. تنحَّ.
Dialogue: 0,0:18:27.23,0:18:29.03,BottomCenter,,0000,0000,0000,,‫تنحَّ.
Dialogue: 0,0:18:32.90,0:18:35.37,BottomCenter,,0000,0000,0000,,‫صـ-صباح الخير يا كاميغاوا!
Dialogue: 0,0:18:37.70,0:18:38.95,BottomCenter,,0000,0000,0000,,‫مُخيف!
Dialogue: 0,0:18:39.12,0:18:42.58,BottomCenter,,0000,0000,0000,,‫إن حيّيته هكذا، فسيظنّ أنّ هناك خطبًا ما!
Dialogue: 0,0:18:42.91,0:18:45.42,BottomCenter,,0000,0000,0000,,{\i1}‫"التواصل مع مرؤوسيك بنبرة{\i0}\N{\i1}‫صارمة هو أمر عفا عليه الزمن".{\i0}
Dialogue: 0,0:18:45.58,0:18:48.55,BottomCenter,,0000,0000,0000,,{\i1}‫"بدلًا من ذلك، لكي يتطوّروا، أثنِ{\i0}\N{\i1}‫على مرؤوسيك مرارًا وتكرارًا..."{\i0}
Dialogue: 0,0:18:48.92,0:18:51.05,BottomCenter,,0000,0000,0000,,{\i1}‫"قوّمهم عندما يحتاجون إلى التقويم..."{\i0}
Dialogue: 0,0:18:53.88,0:18:54.89,BottomCenter,,0000,0000,0000,,‫ماذا؟
Dialogue: 0,0:18:55.51,0:18:58.56,BottomCenter,,0000,0000,0000,,‫إذًا متى بالضبط أُثني عليه؟ أو أُقوّمه؟
Dialogue: 0,0:19:00.64,0:19:04.14,BottomCenter,,0000,0000,0000,,‫التواصل الاستباقي يزيد من الإنتاجيّة...
Dialogue: 0,0:19:04.90,0:19:08.36,BottomCenter,,0000,0000,0000,,‫لا يمكنك التواصل مع المرؤوسين\N‫أثناء الشرب في هذا العصر...
Dialogue: 0,0:19:11.23,0:19:12.94,BottomCenter,,0000,0000,0000,,‫ما الذي يُفترض بي أن أفعله؟
Dialogue: 0,0:19:13.15,0:19:16.49,BottomCenter,,0000,0000,0000,,‫لم أظنّ أبدًا أنّني سأضطرّ\N‫لدفع ثمن التخلّي عن
Dialogue: 0,0:19:16.70,0:19:19.53,BottomCenter,,0000,0000,0000,,‫التواصل بسلاسة مع الناس بهذا الشكل.
Dialogue: 0,0:19:21.75,0:19:25.87,BottomCenter,,0000,0000,0000,,‫يا إلهي! المعكرونة الخاصّة\N‫بي نضجت أكثر من اللازم!
Dialogue: 0,0:19:37.51,0:19:39.76,TopCenter,,0000,0000,0000,,‫بووم! خضراوات
Dialogue: 0,0:19:44.43,0:19:45.52,BottomCenter,,0000,0000,0000,,‫تَبًّا!
Dialogue: 0,0:19:47.52,0:19:51.44,BottomCenter,,0000,0000,0000,,‫موجِّهة تتأخّر؟ لا يُصدّق!
Dialogue: 0,0:20:08.29,0:20:09.29,BottomCenter,,0000,0000,0000,,‫كلّ شيء جاهز!
Dialogue: 0,0:20:17.38,0:20:18.84,BottomCenter,,0000,0000,0000,,{\i1}‫درستُ لليلة واحدة فقط...{\i0}
Dialogue: 0,0:20:19.05,0:20:21.51,BottomCenter,,0000,0000,0000,,{\i1}‫ولكن كلّ ما يمكنني فعله{\i0}\N{\i1}‫هو أن أخطو خطوة بخطوة.{\i0}
Dialogue: 0,0:20:22.89,0:20:23.89,BottomCenter,,0000,0000,0000,,‫هل بدأت تعتاد على العمل؟
Dialogue: 0,0:20:24.10,0:20:25.68,BottomCenter,,0000,0000,0000,,‫- أجل، قليلًا فقط...\N{\i1}‫- حيّي بابتسامة.{\i0}
Dialogue: 0,0:20:25.89,0:20:28.06,BottomCenter,,0000,0000,0000,,{\i1}‫- حيّي بابتسامة.{\i0}\N{\i1}‫- سينباي!{\i0}
Dialogue: 0,0:20:28.27,0:20:31.52,BottomCenter,,0000,0000,0000,,‫- صـ-صباح الـ—\N‫- كاناوا-سان هي موجِّهته؟
Dialogue: 0,0:20:31.82,0:20:33.90,BottomCenter,,0000,0000,0000,,‫أشعر بالأسف لهذا الموظّف الجديد.
Dialogue: 0,0:20:34.11,0:20:35.53,BottomCenter,,0000,0000,0000,,‫يمكن أن تكون صارمة.
Dialogue: 0,0:20:35.86,0:20:40.57,BottomCenter,,0000,0000,0000,,‫كاناوا-سان جميلة، لكنّها تبدو\N‫غاضبة دائمًا، لذا هي مُخيفة.
Dialogue: 0,0:20:40.78,0:20:45.45,BottomCenter,,0000,0000,0000,,‫حسنًا، أظنّ أنّ عملها الجيّد يشفع لها.
Dialogue: 0,0:20:45.66,0:20:49.71,BottomCenter,,0000,0000,0000,,‫ماذا؟ لكن من الصعب العمل معها.
Dialogue: 0,0:20:51.17,0:20:55.05,TopCenter,,0000,0000,0000,,‫-كيفيّة التفاعل مع مرؤوسك: -حيّيه بابتسامة مشرقة!\N‫-اشرح بطريقة سهلة الفهم!\N‫-تجنّب استخدام لغة قاسية!
Dialogue: 0,0:20:55.34,0:20:57.84,BottomCenter,,0000,0000,0000,,‫لا! هل أنتِ بخير يا سينباي؟
Dialogue: 0,0:20:58.34,0:21:02.05,BottomCenter,,0000,0000,0000,,‫أنا سعيدة لأنّها لم تكن موجِّهتي.
Dialogue: 0,0:21:02.22,0:21:03.51,BottomCenter,,0000,0000,0000,,‫عذرًا...
Dialogue: 0,0:21:05.47,0:21:07.23,BottomCenter,,0000,0000,0000,,‫عذرًا.
Dialogue: 0,0:21:14.69,0:21:17.32,BottomCenter,,0000,0000,0000,,‫آسفة. حان وقت بدء العمل تقريبًا.
Dialogue: 0,0:21:17.53,0:21:18.53,BottomCenter,,0000,0000,0000,,‫لنذهب.
Dialogue: 0,0:21:24.28,0:21:25.66,BottomCenter,,0000,0000,0000,,‫أنا سعيد!
Dialogue: 0,0:21:26.08,0:21:29.41,BottomCenter,,0000,0000,0000,,‫تعرّفتُ على جانب كاناوا-سينباي اللطيف.
Dialogue: 0,0:21:29.62,0:21:31.67,BottomCenter,,0000,0000,0000,,‫أشعر أنّني محظوظ أكثر من معظم الناس!
Dialogue: 0,0:21:33.71,0:21:35.71,BottomCenter,,0000,0000,0000,,‫أ-أهكذا الأمر؟
Dialogue: 0,0:21:35.92,0:21:38.17,BottomCenter,,0000,0000,0000,,‫يا إلهي. كاناوا-سان هنا.
Dialogue: 0,0:21:41.93,0:21:44.43,BottomCenter,,0000,0000,0000,,‫عذرًا، تجاوزتُ حدودي.
Dialogue: 0,0:21:46.14,0:21:47.68,BottomCenter,,0000,0000,0000,,‫لن أشكرك.
Dialogue: 0,0:21:47.85,0:21:48.85,BottomCenter,,0000,0000,0000,,‫نعم.
Dialogue: 0,0:21:50.81,0:21:53.65,BottomCenter,,0000,0000,0000,,‫- شكرًا...\N‫- ماذا؟ هل قُلتِ شيئًا؟
Dialogue: 0,0:21:53.86,0:21:55.65,BottomCenter,,0000,0000,0000,,‫لا شيء! لنذهب!
Dialogue: 0,0:21:55.86,0:21:56.86,BottomCenter,,0000,0000,0000,,‫حاضر!
Dialogue: 0,0:21:59.94,0:22:01.95,BottomCenter,,0000,0000,0000,,‫كاميغاوا. بالنسبة لغداء اليوم—
Dialogue: 0,0:22:02.16,0:22:05.03,BottomCenter,,0000,0000,0000,,‫سأتناول عود خضار معه اليوم!
Dialogue: 0,0:22:05.74,0:22:06.87,BottomCenter,,0000,0000,0000,,‫فهمت...
